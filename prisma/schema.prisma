generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Singleton row (id = "singleton") for studio-wide setup.
model Settings {
  id               String   @id
  openrouterApiKey String?
  /// JSON array of absolute filesystem paths granted to Atrium tools.
  allowedPaths     String   @default("[]")
  /// When true and allowlist is non-empty, agents may use run_shell inside granted folders.
  enableShell      Boolean  @default(false)
  /// Opaque secret for same-origin operator actions (shell approve/deny). Auto-generated.
  operatorToken    String?
  updatedAt        DateTime @updatedAt
}

/// Durable pending shell approvals (survive process restart until TTL).
model ShellApproval {
  id        String   @id
  command   String
  cwd       String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Agent {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// Optional short role label (seeded specialists). Custom agents may leave empty.
  title       String   @default("")
  /// Persona / system prompt for this agent.
  description String   @default("")
  /// OpenRouter model id, e.g. "openai/gpt-4o-mini"
  modelId     String   @default("")
  /// Optional display name from OpenRouter, e.g. "OpenAI: GPT-4o Mini"
  modelName   String   @default("")
  accent      String   @default("#5b8a9a")
  createdAt   DateTime @default(now())
  threads     Thread[]
}

model Thread {
  id        String    @id @default(cuid())
  title     String    @default("New conversation")
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  toolHints String?
  createdAt DateTime @default(now())
}

/// Async agent-to-agent inbox (phase 1). threadId groups a multi-hop chain.
model AgentMessage {
  id              String   @id @default(cuid())
  fromAgentSlug   String
  toAgentSlug     String
  /// Shared id for an entire handoff chain (A→B→C).
  threadId        String
  parentMessageId String?
  hopCount        Int      @default(1)
  /// JSON array of agent slugs on the chain path at send time (cycle detection).
  chainSlugsJson  String   @default("[]")
  body            String
  /// JSON array placeholder for phase-2 attachments.
  attachments     String   @default("[]")
  status          String   @default("queued")
  error           String?
  /// Reply text when status is done (also copied to sender thread as agent_reply).
  reply           String?
  /// JSON ToolLogEntry[] from the receiver run (fs writes/edits surfaced to sender).
  receiverToolLog String?
  /// Sender chat thread to append agent_reply / tool updates.
  senderThreadId  String?
  senderToolLogId String?
  /// Idempotent failure notification on sender thread (recovery sweep).
  senderNotified  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([threadId])
  @@index([fromAgentSlug, createdAt])
}
