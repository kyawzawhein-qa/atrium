# SQLite database (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Studio login password (default for local demo: atrium)
ATRIUM_PASSWORD="atrium"

# JWT signing secret for session cookies
ATRIUM_SESSION_SECRET="change-me-in-production"

# --- LLM (optional) ---
# Prefer OpenAI-compatible chat completions when set:
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"   # or any compatible base
# OPENAI_MODEL="gpt-4o-mini"

# Else Ollama when OPENAI_API_KEY is unset:
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3.2"

# If neither is set, Atrium uses a high-quality offline stub
# that still answers in each agent's voice (marked in replies).
