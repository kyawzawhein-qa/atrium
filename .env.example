# SQLite database (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Optional public URL sent to OpenRouter as HTTP-Referer
# ATRIUM_PUBLIC_URL="http://localhost:3000"

# Optional: allow POST /api/demo/setup when the dev server is not on localhost.
# Default: demo bootstrap is localhost + same-origin operator session only.
# ATRIUM_DEMO_SETUP=1

# OpenRouter API key is NOT stored here.
# Paste it in the app at /settings — it lives in the SQLite Settings row.
# Never commit the key.
